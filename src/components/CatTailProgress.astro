---
/**
 * 猫尾阅读进度条
 * 设计：一根横贯顶部的毛茸茸猫尾，已读部分是亮色渐变，未读部分是淡淡的轮廓；
 *      尾巴尖（一团蓬松毛球 + 几缕长毛）随阅读进度一起向右移动 —— 读到哪里，尾巴尖就在哪里。
 * 无 JS 时整条隐藏，不影响内容。
 */

// —— 服务器端生成绒毛轮廓（固定种子，保证每次构建结果一致） ——
let seed = 20260402; // aylen 的存在起点坐标
const rnd = () => {
  seed = (seed * 1103515245 + 12345) & 0x7fffffff;
  return seed / 0x7fffffff;
};

const W = 1000;
const CY = 13;
const HALF = 6.4;

// 尾巴主体：带轻微起伏的上下轮廓
const bodyPts: string[] = [];
for (let x = 0; x <= W; x += 20) {
  const wob = Math.sin(x / 90) * 1.1;
  bodyPts.push(`${x},${(CY - HALF - wob).toFixed(2)}`);
}
for (let x = W; x >= 0; x -= 20) {
  const wob = Math.sin(x / 110 + 1.7) * 1.1;
  bodyPts.push(`${x},${(CY + HALF + wob).toFixed(2)}`);
}
const bodyPath = `M${bodyPts.join(' L')} Z`;

// 绒毛：沿上下轮廓生成长短不一的细毛
type Strand = { d: string; o: number };
const strands: Strand[] = [];
for (let x = 2; x < W; x += 7) {
  for (const dir of [-1, 1]) {
    const wob = Math.sin(x / (dir < 0 ? 90 : 110) + (dir < 0 ? 0 : 1.7)) * 1.1;
    const baseY = CY + dir * (HALF + wob);
    const len = 3 + rnd() * 6;
    const lean = (rnd() - 0.5) * 5;
    const wdt = 0.7 + rnd() * 0.7;
    strands.push({
      d: `M${x},${baseY.toFixed(2)} L${(x + lean).toFixed(2)},${(baseY + dir * len).toFixed(2)}`,
      o: wdt,
    });
  }
}
---

<div class="cat-tail" data-cat-tail aria-hidden="true">
  <svg viewBox={`0 0 ${W} 26`} preserveAspectRatio="none">
    <defs>
      <linearGradient id="ctGrad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2={W} y2="0">
        <stop class="ct-s1" offset="0" />
        <stop class="ct-s2" offset="0.62" />
        <stop class="ct-s3" offset="1" />
      </linearGradient>
      <!-- 进度遮罩：右边界随阅读进度推进，并带一小段柔和过渡 -->
      <linearGradient id="ctReveal" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2={W} y2="0">
        <stop data-reveal-a offset="0" stop-color="#fff" />
        <stop data-reveal-b offset="0" stop-color="#000" />
      </linearGradient>
      <mask id="ctMask">
        <rect x="0" y="0" width={W} height="26" fill="url(#ctReveal)" />
      </mask>
      <g id="ctTail">
        <path d={bodyPath} />
        <g class="ct-fur">
          {strands.map((s) => (
            <path d={s.d} stroke-width={s.o.toFixed(2)} />
          ))}
        </g>
      </g>
    </defs>

    <!-- 未读：淡淡的整条轮廓 -->
    <use href="#ctTail" class="ct-unread" />
    <!-- 已读：被遮罩露出 -->
    <use href="#ctTail" class="ct-read" mask="url(#ctMask)" />

    <!-- 尾巴尖：跟着进度走 -->
    <g class="ct-tip" data-ct-tip>
      <g class="ct-tip-fur">
        {Array.from({ length: 14 }).map((_, i) => {
          const a = (i / 14) * Math.PI * 2 + 0.3;
          const r0 = 8.4;
          const r1 = r0 + 3 + rnd() * 6;
          return (
            <path
              d={`M${(Math.cos(a) * r0).toFixed(2)},${(Math.sin(a) * r0).toFixed(2)} ` +
                `L${(Math.cos(a) * r1).toFixed(2)},${(Math.sin(a) * r1).toFixed(2)}`}
              stroke-width={(0.7 + rnd() * 0.8).toFixed(2)}
            />
          );
        })}
      </g>
      <ellipse class="ct-tip-ball" rx="9.4" ry="8.6" />
    </g>
  </svg>
</div>

<style>
  .cat-tail {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 26px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s var(--ease-water);
  }
  .cat-tail.visible {
    opacity: 1;
  }
  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ct-s1 { stop-color: var(--accent); }
  .ct-s2 { stop-color: var(--accent); }
  .ct-s3 { stop-color: var(--accent-2); }

  .ct-unread path,
  .ct-unread ellipse {
    fill: var(--accent);
    opacity: 0.14;
  }
  .ct-unread .ct-fur path {
    fill: none;
    opacity: 0.5;
  }
  .ct-read path,
  .ct-read ellipse {
    fill: url(#ctGrad);
  }
  .ct-read .ct-fur path {
    fill: none;
    stroke: url(#ctGrad);
  }
  /* 已读部分加一层柔光，毛茸茸更明显 */
  .ct-read {
    filter: drop-shadow(0 0 5px var(--accent-soft));
  }

  .ct-tip {
    transform: translateX(0);
    will-change: transform;
  }
  .ct-tip .ct-tip-ball {
    fill: url(#ctGrad);
  }
  .ct-tip .ct-tip-fur path {
    fill: none;
    stroke: url(#ctGrad);
  }
  .ct-tip {
    filter: drop-shadow(0 0 6px var(--accent-soft));
  }

  @media (prefers-reduced-motion: reduce) {
    .cat-tail {
      transition: none;
    }
  }
</style>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-cat-tail]');
  const tip = document.querySelector<SVGGElement>('[data-ct-tip]');
  const ra = document.querySelector<SVGStopElement>('[data-reveal-a]');
  const rb = document.querySelector<SVGStopElement>('[data-reveal-b]');
  if (wrap && tip && ra && rb) {
    const W = 1000;
    let ticking = false;
    const update = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;

      // 只有真正开始阅读才出现，避免首页顶部就露出
      wrap.classList.toggle('visible', p > 0.015);

      // 尾巴尖位置（留出右侧余量，且不超出视口）
      const tipX = Math.min(W - 12, Math.max(10, p * (W - 12)));
      tip.style.transform = `translateX(${tipX.toFixed(1)}px)`;

      // 已读遮罩右边界 + 一小段柔和过渡
      const ahead = Math.max(0, (p - 0.02) * W);
      ra.setAttribute('offset', String(ahead / W));
      rb.setAttribute('offset', String(Math.max(ahead + 26, p * W) / W));
      ticking = false;
    };
    addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    addEventListener('resize', update, { passive: true });
    update();
  }
</script>
