---
/**
 * 文章页底部的「语录」区块
 *  - 数据在 consts.ts 的 POST_QUOTES（倒序：新的在前）——加一条 = 往数组里加一行
 *  - 每条 = 语录文本 + 日期；可选配图（卡片顶部一条插画带，下缘淡出接正文）
 *  - 日期显示：当年只写「X 月 X 日」，跨年才带年份
 */
import Ornament from './Ornament.astro';
import { POST_QUOTES } from '../consts';
import { mediaUrl } from '../lib/media';

const thisYear = new Date().getFullYear();

function formatDate(iso: string): string {
  // 手动拆 ISO，避免 new Date() 的时区把日期挪一天
  const [y, m, d] = iso.split('-').map(Number);
  const md = `${m} 月 ${d} 日`;
  return y === thisYear ? md : `${y} 年 ${md}`;
}
---

<Ornament motif="bubble" label="语录" />

<section class="quotes" aria-label="语录">
  <h2 class="q-head"><span class="ord">语录</span>WHISPERS</h2>
  <ul class="q-list">
    {
      POST_QUOTES.map((q) => (
        <li class="q-card">
          {q.image && (
            <span class="q-img">
              <img
                src={mediaUrl(q.image)}
                alt={q.alt ?? ''}
                width="1920"
                height="1080"
                loading="lazy"
              />
            </span>
          )}
          <div class="q-body">
            <p class="q-text">{q.text}</p>
            <p class="q-time">
              <time datetime={q.date}>{formatDate(q.date)}</time>
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .q-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .q-head::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--ornament), transparent);
    opacity: 0.5;
  }
  .q-head .ord {
    font-family: var(--font-hand);
    font-size: 1.3rem;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .q-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .q-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    overflow: hidden;
    transition: border-color 0.3s, transform 0.3s var(--ease-water);
  }
  .q-card:hover {
    border-color: var(--border-strong);
  }

  /* 配图：卡片顶部一条插画带，下缘淡出，和文字区不留硬边 */
  .q-img {
    display: block;
    aspect-ratio: 2.2 / 1;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, #000 0 70%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0 70%, transparent 100%);
  }
  .q-img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 44%;
  }

  .q-body {
    padding: 16px 24px 18px;
  }
  .q-text {
    padding-left: 14px;
    border-left: 2px solid var(--accent);
    font-size: 1.02rem;
    line-height: 1.9;
    color: var(--text);
  }
  .q-time {
    margin-top: 12px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .q-time::before {
    content: '';
    flex: 0 0 26px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--ornament));
    opacity: 0.6;
  }

  @media (max-width: 560px) {
    .q-body {
      padding: 14px 18px 16px;
    }
    .q-text {
      padding-left: 11px;
    }
  }
</style>
