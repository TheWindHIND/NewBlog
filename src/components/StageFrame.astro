---
/**
 * 全站舞台框架：把整个博客变成枫丹歌剧院的舞台
 *  · 两侧天鹅绒幕布（窄屏自动隐藏）
 *  · 顶部聚光灯 + 缓慢漂移的水面光斑
 *  · 环境泡泡 / 音符 / 水珠 Canvas（低透明度、极缓）
 *  · 四角金色藤蔓角饰
 * 全部 pointer-events:none，位于内容之下，不影响阅读与交互。
 */
---

<div class="stage-frame" aria-hidden="true">
  <div class="spotlight"></div>
  <div class="glow glow-a"></div>
  <div class="glow glow-b"></div>
  <canvas data-ambient></canvas>

  <div class="curtain curtain-l">
    <span class="rope"></span>
  </div>
  <div class="curtain curtain-r">
    <span class="rope"></span>
  </div>

  <svg class="corner corner-tl" viewBox="0 0 64 64">
    <path d="M2 34 C2 14 14 2 34 2 M2 34 C12 34 22 30 26 20 C30 10 24 4 18 8 C12 12 16 22 26 26" />
    <circle cx="34" cy="2" r="2.2" />
  </svg>
  <svg class="corner corner-br" viewBox="0 0 64 64">
    <path d="M2 34 C2 14 14 2 34 2 M2 34 C12 34 22 30 26 20 C30 10 24 4 18 8 C12 12 16 22 26 26" />
    <circle cx="34" cy="2" r="2.2" />
  </svg>
</div>

<style>
  .stage-frame {
    position: fixed;
    inset: 0;
    /* 压在内容之下、页面底色之上（body 底色会传播到画布，故 -1 仍可见） */
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  /* 顶部聚光灯 */
  .spotlight {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 58% 42% at 50% -6%, var(--spot), transparent 68%),
      linear-gradient(180deg, transparent 62%, var(--bg) 100%);
  }

  /* 水面光斑：缓慢漂移 */
  .glow {
    position: absolute;
    width: 46vmax;
    height: 46vmax;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.5;
    background: radial-gradient(circle, var(--accent-soft), transparent 70%);
  }
  .glow-a {
    top: -18vmax;
    left: -12vmax;
    animation: drift-a 46s ease-in-out infinite;
  }
  .glow-b {
    bottom: -20vmax;
    right: -14vmax;
    background: radial-gradient(circle, var(--accent-2-soft), transparent 70%);
    animation: drift-b 58s ease-in-out infinite;
  }
  @keyframes drift-a {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(6vmax, 4vmax, 0) scale(1.12); }
  }
  @keyframes drift-b {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1.08); }
    50% { transform: translate3d(-5vmax, -6vmax, 0) scale(1); }
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.55;
  }

  /* 两侧天鹅绒幕布 */
  .curtain {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--stage-edge);
    background:
      repeating-linear-gradient(
        90deg,
        var(--curtain-a) 0px,
        var(--curtain-b) 12px,
        var(--curtain-a) 26px,
        var(--curtain-b) 38px,
        var(--curtain-a) 52px
      );
    box-shadow: 0 0 30px rgba(0, 0, 0, 0.35);
    animation: sway 12s var(--ease-water) infinite;
  }
  .curtain-l {
    left: 0;
    border-radius: 0 22px 22px 0;
    transform-origin: left center;
  }
  .curtain-r {
    right: 0;
    border-radius: 22px 0 0 22px;
    transform-origin: right center;
    animation-delay: -6s;
  }
  @keyframes sway {
    0%, 100% { transform: scaleX(1); }
    50% { transform: scaleX(1.06); }
  }
  /* 幕布内侧的金线 + 流苏 */
  .curtain .rope {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(
      180deg,
      transparent,
      var(--gold-trim) 12%,
      var(--gold-trim) 88%,
      transparent
    );
    opacity: 0.5;
  }
  .curtain-l .rope { right: 6px; }
  .curtain-r .rope { left: 6px; }

  /* 四角金色藤蔓 */
  .corner {
    position: absolute;
    width: 62px;
    height: 62px;
    fill: none;
    stroke: var(--ornament);
    stroke-width: 1.4;
    stroke-linecap: round;
    opacity: 0.75;
  }
  .corner circle { fill: var(--ornament); stroke: none; }
  .corner-tl { top: calc(var(--nav-h) + 10px); left: 10px; }
  .corner-br { bottom: 10px; right: 10px; transform: rotate(180deg); }

  /* 窄屏：收起幕布与角饰，只留光效 */
  @media (max-width: 1180px) {
    .curtain { width: 16px; }
    .corner { display: none; }
  }
  @media (max-width: 760px) {
    .curtain { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .glow, .curtain { animation: none !important; }
  }
</style>

<script>
  // 环境粒子：泡泡 / 音符 / 水珠，极缓上升
  const canvas = document.querySelector<HTMLCanvasElement>('[data-ambient]');
  if (canvas && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      let w = 0, h = 0;
      const dpr = Math.min(devicePixelRatio || 1, 1.5);
      const resize = () => {
        w = innerWidth;
        h = innerHeight;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };
      resize();
      addEventListener('resize', resize, { passive: true });

      type Kind = 'bubble' | 'note' | 'drop';
      type P = { x: number; y: number; r: number; v: number; ph: number; k: Kind; rot: number; spin: number };
      const kinds: Kind[] = ['bubble', 'bubble', 'bubble', 'bubble', 'drop', 'note'];
      const spawn = (init = false): P => {
        const k = kinds[Math.floor(Math.random() * kinds.length)];
        return {
          x: Math.random() * w,
          y: init ? Math.random() * h : h + 20 + Math.random() * 80,
          r: k === 'note' ? 7 + Math.random() * 5 : 2 + Math.random() * 8,
          v: 0.12 + Math.random() * 0.3,
          ph: Math.random() * Math.PI * 2,
          k,
          rot: Math.random() * Math.PI * 2,
          spin: (Math.random() - 0.5) * 0.006,
        };
      };
      const count = () => Math.round(Math.min(20, Math.max(7, w / 90)));
      let ps: P[] = Array.from({ length: count() }, () => spawn(true));

      let t = 0;
      let raf = 0;
      const accent = () =>
        getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#5bc0e8';
      let col = accent();
      addEventListener('catnest:theme', () => { col = accent(); });
      setInterval(() => { col = accent(); }, 2500);

      const draw = () => {
        t += 0.016;
        ctx.clearRect(0, 0, w, h);
        for (const p of ps) {
          p.y -= p.v;
          p.x += Math.sin(t * 0.5 + p.ph) * 0.22;
          p.rot += p.spin;
          if (p.y < -30) Object.assign(p, spawn());

          ctx.save();
          ctx.translate(p.x, p.y);
          if (p.k === 'bubble') {
            const g = ctx.createRadialGradient(-p.r * 0.35, -p.r * 0.35, p.r * 0.1, 0, 0, p.r);
            g.addColorStop(0, 'rgba(255,255,255,0.35)');
            g.addColorStop(1, 'rgba(255,255,255,0.02)');
            ctx.beginPath();
            ctx.arc(0, 0, p.r, 0, Math.PI * 2);
            ctx.fillStyle = g;
            ctx.fill();
            ctx.strokeStyle = 'rgba(255,255,255,0.16)';
            ctx.lineWidth = 0.9;
            ctx.stroke();
          } else if (p.k === 'drop') {
            ctx.beginPath();
            ctx.moveTo(0, -p.r);
            ctx.quadraticCurveTo(p.r * 0.85, p.r * 0.25, 0, p.r);
            ctx.quadraticCurveTo(-p.r * 0.85, p.r * 0.25, 0, -p.r);
            ctx.fillStyle = col;
            ctx.globalAlpha = 0.16;
            ctx.fill();
          } else {
            // 八分音符
            ctx.rotate(p.rot * 0.3);
            ctx.globalAlpha = 0.17;
            ctx.fillStyle = col;
            ctx.beginPath();
            ctx.ellipse(0, p.r * 0.6, p.r * 0.62, p.r * 0.46, -0.35, 0, Math.PI * 2);
            ctx.fill();
            ctx.lineWidth = 1.5;
            ctx.strokeStyle = col;
            ctx.beginPath();
            ctx.moveTo(p.r * 0.55, p.r * 0.5);
            ctx.lineTo(p.r * 0.55, -p.r);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(p.r * 0.55, -p.r);
            ctx.quadraticCurveTo(p.r * 1.5, -p.r * 0.7, p.r * 0.9, -p.r * 0.1);
            ctx.stroke();
          }
          ctx.restore();
        }
        raf = requestAnimationFrame(draw);
      };
      raf = requestAnimationFrame(draw);

      // 标签页隐藏时暂停，省电
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          cancelAnimationFrame(raf);
          raf = 0;
        } else if (!raf) {
          raf = requestAnimationFrame(draw);
        }
      });
    }
  }
</script>
