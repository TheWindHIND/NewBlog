---
/**
 * 页脚猫窝：Live2D 芙宁娜猫猫 + 猫窝养成阶段标签
 * 回访次数（每会话 +1）决定猫窝阶段，并影响猫猫的心情
 */
import Live2DCat from './Live2DCat.astro';
import { CAT_NEST_STAGES } from '../consts';
---

<div class="footer-cat">
  <Live2DCat size="clamp(128px, 16vw, 186px)" class="cat-l2d" greet />
  <p class="nest-label">
    <span class="stage" data-nest-stage>猫窝 · 初来乍到</span>
    <span class="visits" data-nest-visits></span>
  </p>
  <div class="nest-progress" aria-hidden="true">
    <span data-nest-bar></span>
  </div>
</div>

<style>
  .footer-cat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .cat-l2d {
    filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.35));
  }
  .nest-label {
    font-size: 0.8rem;
    color: var(--muted);
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .stage {
    font-family: var(--font-hand);
    color: var(--accent-2);
    letter-spacing: 0.08em;
  }
  .visits {
    opacity: 0.85;
  }
  .nest-progress {
    width: 132px;
    height: 3px;
    border-radius: 999px;
    background: var(--accent-soft);
    overflow: hidden;
  }
  .nest-progress span {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transition: width 1.2s var(--ease-water);
  }
</style>

<script>
  import { catnest } from '../scripts/catnest';
  import { CAT_NEST_STAGES } from '../consts';

  const visits = catnest.countVisit();
  const stage = [...CAT_NEST_STAGES].reverse().find((s) => visits >= s.min) ?? CAT_NEST_STAGES[0];
  const el = document.querySelector('[data-nest-stage]');
  const v = document.querySelector('[data-nest-visits]');
  if (el) el.textContent = `猫窝 · ${stage.name}`;
  if (v) v.textContent = `来访 ${visits} 次`;

  const bar = document.querySelector<HTMLElement>('[data-nest-bar]');
  if (bar) {
    const next = CAT_NEST_STAGES.find((s) => s.min > visits);
    const from = stage.min;
    const to = next ? next.min : stage.min;
    const p = next ? Math.min(1, (visits - from) / Math.max(1, to - from)) : 1;
    bar.style.width = `${Math.round(p * 100)}%`;
  }
</script>
