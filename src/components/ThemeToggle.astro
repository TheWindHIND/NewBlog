---
/**
 * 荒 / 芒 主题切换
 *  · 图标：寒天之钉（Skyfrost Nail）
 *      · 荒 Ousia（夜）→ 完整的钉子
 *      · 芒 Pneuma（昼）→ 碎掉的钉子
 *    两态同框堆叠，由 data-theme 交叉淡入淡出，无需 JS 参与换图。
 *    几何见 src/lib/nail-geom.mjs，配色走 --nail-* 变量。
 *  · 点击时图标转一圈，发光色随当前形态在香槟金 / 深海蓝之间切换
 */
import { nailSVG } from '../lib/nail-geom.mjs';

const whole = nailSVG('whole');
const shattered = nailSVG('shattered');
---

<button class="theme-toggle" type="button" aria-label="切换荒/芒主题" title="荒 · 完整的寒天之钉 / 芒 · 碎裂的寒天之钉" data-theme-toggle>
  <span class="nt-icon" data-nt-icon>
    <span class="nt-whole"><Fragment set:html={whole} /></span>
    <span class="nt-shattered"><Fragment set:html={shattered} /></span>
  </span>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    transition: background-color 0.3s;
  }
  .theme-toggle:hover {
    background: var(--bg-soft);
  }

  .nt-icon {
    position: relative;
    display: block;
    width: 26px;
    height: 32px;
    transition: transform 0.3s var(--ease-water);
    filter: drop-shadow(0 0 6px var(--toggle-glow));
  }
  .nt-icon > span {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.5s var(--ease-water), transform 0.5s var(--ease-water);
  }
  .nt-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* 当前形态：荒=完整、芒=碎裂 */
  :global(:root[data-theme='ousia']) .nt-whole {
    opacity: 1;
  }
  :global(:root[data-theme='pneuma']) .nt-shattered {
    opacity: 1;
  }
  /* 未指定主题时的兜底 */
  :global(:root:not([data-theme])) .nt-whole {
    opacity: 1;
  }

  .theme-toggle:hover .nt-icon {
    transform: scale(1.08) rotate(-6deg);
  }
  .theme-toggle:active .nt-icon {
    transform: scale(0.94);
  }

  /* 切换瞬间：转一圈 */
  .nt-icon.spin {
    animation: toggle-spin 0.8s var(--ease-water);
    transition: none;
  }
  @keyframes toggle-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nt-icon,
    .nt-icon > span,
    .nt-icon.spin {
      animation: none;
      transition: none;
    }
    .theme-toggle:hover .nt-icon {
      transform: none;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (btn) {
    const icon = btn.querySelector<HTMLElement>('[data-nt-icon]');
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'ousia' ? 'pneuma' : 'ousia';
      const apply = () => {
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('catnest.theme', next);
        } catch {}
        window.dispatchEvent(new CustomEvent('catnest:theme', { detail: { theme: next } }));
      };
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced && document.startViewTransition) {
        document.startViewTransition(apply);
      } else {
        apply();
      }
      // 转一圈作为「换形态」的反馈
      if (icon && !reduced) {
        icon.classList.remove('spin');
        void icon.offsetWidth; // 强制重排，让动画可重复触发
        icon.classList.add('spin');
        icon.addEventListener('animationend', () => icon.classList.remove('spin'), { once: true });
      }
    });
  }
</script>
