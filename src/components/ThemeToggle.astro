---
/**
 * 芙宁娜异色瞳主题切换（正典配色）
 * 左眼：深蓝虹膜 + 浅蓝水滴瞳孔 ｜ 右眼：浅蓝虹膜 + 深蓝水滴瞳孔
 * 左眼代表「昼·芒」，右眼代表「夜·荒」——当前形态一侧发光（水幕过渡见 base.css）
 */
---

<button class="theme-toggle" type="button" aria-label="切换荒/芒主题" title="荒 / 芒" data-theme-toggle>
  <svg viewBox="0 0 64 40" aria-hidden="true">
    <defs>
      <!-- 水滴形瞳孔：尖朝上 -->
      <path id="ct-drop" d="M0 -4.6 C1.8 -2.4 3 0 3 1.8 A3 3 0 1 1 -3 1.8 C-3 0 -1.8 -2.4 0 -4.6 Z" />
    </defs>
    <!-- 眼眶 -->
    <ellipse class="socket" cx="18" cy="20" rx="15" ry="17.5" />
    <ellipse class="socket" cx="46" cy="20" rx="15" ry="17.5" />
    <!-- 左眼：深蓝虹膜 + 浅蓝水滴瞳孔 -->
    <circle class="iris iris-l" cx="18" cy="20" r="10.5" />
    <use class="pupil pupil-l" href="#ct-drop" x="18" y="20" />
    <!-- 右眼：浅蓝虹膜 + 深蓝水滴瞳孔 -->
    <circle class="iris iris-r" cx="46" cy="20" r="10.5" />
    <use class="pupil pupil-r" href="#ct-drop" x="46" y="20" />
    <!-- 高光 -->
    <circle class="glint" cx="14.5" cy="15.5" r="2" />
    <circle class="glint" cx="42.5" cy="15.5" r="2" />
    <!-- 当前形态一侧的发光标记（芒=左，荒=右） -->
    <ellipse class="ring ring-l" cx="18" cy="20" rx="14" ry="16.4" />
    <ellipse class="ring ring-r" cx="46" cy="20" rx="14" ry="16.4" />
  </svg>
</button>

<style>
  .theme-toggle {
    padding: 4px;
    border-radius: 999px;
    transition: transform 0.25s var(--ease-water);
  }
  .theme-toggle:hover {
    transform: scale(1.12) rotate(-6deg);
  }
  .theme-toggle:active {
    transform: scale(0.95);
  }
  svg {
    width: 52px;
    height: 33px;
    overflow: visible;
  }
  .socket {
    fill: var(--bg-soft);
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }
  /* 正典配色：左深蓝 / 右浅蓝 */
  .iris-l {
    fill: #2b5f96;
  }
  .iris-r {
    fill: #7fc9ea;
  }
  .pupil-l {
    fill: #b9e4f7;
  }
  .pupil-r {
    fill: #16324e;
  }
  .glint {
    fill: #fff;
    opacity: 0.85;
  }
  /* 当前形态标记环：芒→左眼，荒→右眼 */
  .ring {
    fill: none;
    stroke-width: 1.8;
    opacity: 0;
    transition: opacity 0.4s, filter 0.4s;
  }
  .ring-l,
  .ring-r {
    stroke: var(--eye-current);
  }
  :root[data-theme='pneuma'] .ring-l {
    opacity: 1;
    filter: drop-shadow(0 0 5px var(--eye-current));
  }
  :root[data-theme='ousia'] .ring-r {
    opacity: 1;
    filter: drop-shadow(0 0 5px var(--eye-current));
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (btn) {
    btn.addEventListener('click', () => {
      const next =
        document.documentElement.dataset.theme === 'ousia' ? 'pneuma' : 'ousia';
      const apply = () => {
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('catnest.theme', next);
        } catch {}
        window.dispatchEvent(new CustomEvent('catnest:theme', { detail: { theme: next } }));
      };
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced && document.startViewTransition) {
        document.startViewTransition(apply);
      } else {
        apply();
      }
    });
  }
</script>
