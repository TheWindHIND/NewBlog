---
/**
 * 芙芙的小包厢：把「猫窝养成」从卡片列表变成一间真的房间。
 * 回访次数越多，房间里的东西越齐 —— 全部基于 localStorage，不上传任何数据。
 * v3（2026-10-03）：整屋枫丹化 ——
 *   拱形墙板 / 水晶吊灯 / 窗外枫丹廷风景（昼夜两套）；
 *   新家具：壁炉（炉火 + 幽光星星罐 + 齿轮摆件）、书柜（书 + 蒸汽鸟报 + 美露莘 + 小闹钟）、
 *   猫窝天鹅绒床、喷泉水盆、马卡龙碟；
 *   枫丹特产：泡泡桔 / 虹彩蔷薇 / 苍晶螺 / 幽光星星 / 美露莘摆件 / 发条齿轮 / 蒸汽鸟报。
 * 布景铁律：主角猫是 HTML 浮层，占 stage 中央 26% 宽（≈viewBox x296–504、头顶 y≈96），
 *   墙面家具必须避开这条中带。
 */
import Live2DCat from './Live2DCat.astro';

// 沿灯串曲线生成灯泡位置
const bulbs: { x: number; y: number }[] = [];
for (let i = 0; i <= 16; i++) {
  const t = i / 16;
  const x = 56 + t * 688;
  // 二次贝塞尔 P0(56,46) P1(400,100) P2(744,46)
  const y = (1 - t) * (1 - t) * 46 + 2 * (1 - t) * t * 100 + t * t * 46;
  bulbs.push({ x, y });
}

// 拱形墙板（枫丹味：圆拱顶 + 直落到底）
const panel = (x: number, w: number, top: number, bot: number) => {
  const r = w / 2;
  return `M${x} ${bot} V${top + r} A${r} ${r} 0 0 1 ${x + w} ${top + r} V${bot} Z`;
};

// 书柜里的书：从 x0 起一册挨一册排（[宽, 高]）
const BOOK_COLORS = ['var(--accent)', 'var(--accent-2)', 'var(--gold-trim)', 'var(--ornament)'];
const bookRow = (x0: number, bottom: number, spec: [number, number][]) => {
  let x = x0;
  let i = 0;
  return spec.map(([w, h]) => {
    const b = { x, y: bottom - h, w, h, c: BOOK_COLORS[i++ % 4] };
    x += w + 1;
    return b;
  });
};
const booksA = bookRow(178, 156, [
  [7, 22], [6, 18], [8, 25], [5, 16], [7, 21], [6, 24], [8, 18], [5, 20], [7, 23], [6, 19],
]);
const booksB = bookRow(178, 206, [
  [6, 17], [8, 22], [5, 19], [7, 24], [6, 18], [8, 21], [5, 15], [7, 22], [6, 25], [5, 18], [7, 20],
]);
const booksC = bookRow(216, 258, [[7, 18], [6, 22], [8, 16], [5, 20], [7, 17]]);
const booksD = bookRow(178, 314, [
  [9, 28], [8, 32], [7, 26], [10, 30], [8, 24], [9, 34], [7, 28], [8, 30], [6, 25], [9, 27],
]);

// 相框（挂在右墙猫爬架上方）
const FRAMES = [
  { x: 686, y: 56, w: 52, h: 42, rot: -4, fill: 'var(--accent-2)' },
  { x: 744, y: 62, w: 48, h: 38, rot: 3, fill: 'var(--accent)' },
  { x: 712, y: 106, w: 44, h: 34, rot: -2, fill: 'var(--accent-2)' },
];
