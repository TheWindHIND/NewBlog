<style>
  .cat-room {
    margin-top: 8px;
    border: 1px solid var(--frame-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .stage {
    position: relative;
    aspect-ratio: 800 / 460;
    background: var(--room-wall);
  }
  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .cat-slot {
    position: absolute;
    left: 50%;
    bottom: 5%;
    width: 26%;
    transform: translateX(-50%);
    filter: drop-shadow(0 12px 22px rgba(0, 0, 0, 0.32));
  }

  /* 家具：未解锁时隐藏，解锁后弹入 */
  .it {
    opacity: 0;
    transform: translateY(12px);
    transform-box: fill-box;
    transform-origin: bottom center;
    transition: opacity 0.6s var(--ease-water), transform 0.7s var(--ease-water);
  }
  .it.on {
    opacity: 1;
    transform: none;
    transition-delay: var(--d, 0s);
  }
  .bulb {
    fill: var(--gold-trim);
    animation: bulb-blink 3.4s ease-in-out infinite;
  }
  @keyframes bulb-blink {
    0%, 100% { opacity: 0.45; }
    50% { opacity: 1; }
  }
  /* 吊灯轻轻摇 */
  .lamp-sway {
    transform-origin: 400px 8px;
    animation: lamp-sway 6.5s ease-in-out infinite alternate;
  }
  @keyframes lamp-sway {
    from { transform: rotate(-1.1deg); }
    to { transform: rotate(1.1deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bulb { animation: none; opacity: 0.8; }
    .it { transition: none; }
    .lamp-sway { animation: none; }
  }
</style>

<script>
  import { catnest } from '../scripts/catnest';
  const room = document.querySelector<HTMLElement>('[data-cat-room]');
  if (room) {
    const visits = catnest.countVisit();
    const nodes = [...room.querySelectorAll<SVGGElement>('.it[data-need]')]
      .map((el) => ({ el, need: Number(el.dataset.need ?? '0') }))
      .sort((a, b) => a.need - b.need);
    nodes.forEach(({ el, need }, i) => {
      el.style.setProperty('--d', `${Math.min(i * 0.09, 0.5)}s`);
      if (visits >= need) el.classList.add('on');
    });
    // 总投喂量显示在说明区
    const feed = document.querySelector('[data-room-feed]');
    if (feed) feed.textContent = String(catnest.totalFeed());
  }
</script>
