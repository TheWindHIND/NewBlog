---
import FooterCat from './FooterCat.astro';
import { SITE, QUOTES } from '../consts';

const B = import.meta.env.BASE_URL.replace(/\/+$/, '');
const year = new Date().getFullYear();

// 每日语录：按本地日期做 seed 轮换
const today = new Date();
const daySeed = today.getFullYear() * 372 + (today.getMonth() + 1) * 31 + today.getDate();
const quote = QUOTES[daySeed % QUOTES.length];
---

<footer class="site-footer">
  <div class="container">
    <blockquote class="quote" data-quote>
      <p data-quote-text>{quote}</p>
      <cite>—— {SITE.title} · 今日一句</cite>
    </blockquote>

    <!-- 语录原文交给前端：纯静态站构建时算出的「今天」是构建日，
         访客隔天再来仍是旧句。这里让浏览器按自己的日期再算一次 -->
    <script type="application/json" id="site-quotes" set:html={JSON.stringify(QUOTES)} />

    <FooterCat />

    <nav class="foot-links" aria-label="页脚导航">
      <a href={`${B}/posts`}>文章</a>
      <span>·</span>
      <a href={`${B}/archive`}>星空归档</a>
      <span>·</span>
      <a href={`${B}/room`}>芙芙的小包厢</a>
      <span>·</span>
      <a href={`${B}/gallery`}>图库</a>
      <span>·</span>
      <a href={`${B}/rss.xml`}>RSS</a>
    </nav>

    <p class="copy">© {year} {SITE.author} · 藏枫的猫窝 · Powered by Astro</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 72px;
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
    padding: 44px 0 30px;
    text-align: center;
  }
  .quote {
    max-width: 560px;
    margin: 0 auto 30px;
    color: var(--text);
  }
  .quote p {
    font-family: var(--font-hand);
    font-size: 1.12rem;
    color: var(--accent);
  }
  .quote cite {
    display: block;
    margin-top: 6px;
    font-size: 0.8rem;
    font-style: normal;
    color: var(--muted);
  }
  .foot-links {
    margin-top: 22px;
    display: flex;
    justify-content: center;
    gap: 10px;
    font-size: 0.9rem;
  }
  .foot-links span {
    color: var(--muted);
  }
  .copy {
    margin-top: 12px;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>

<script>
  // 「今日一句」按访客本地日期轮换（公式与构建时一致，只是日期换成访客当天）
  const holder = document.querySelector<HTMLElement>('[data-quote]');
  const raw = document.getElementById('site-quotes')?.textContent;
  if (holder && raw) {
    try {
      const quotes: string[] = JSON.parse(raw);
      const t = new Date();
      const seed = t.getFullYear() * 372 + (t.getMonth() + 1) * 31 + t.getDate();
      const today = quotes[seed % quotes.length];
      const target = holder.querySelector<HTMLElement>('[data-quote-text]');
      if (target && today && target.textContent !== today) target.textContent = today;
    } catch {
      /* 语录缺失时保留构建时那一条即可 */
    }
  }
</script>
