---
/**
 * 芙宁娜风图标集（内联 SVG，零外部依赖）
 * 用 <Icon name="hat" /> 调用。全部 currentColor 描边，随主题变色。
 */
interface Props {
  name: 'hat' | 'mask' | 'note' | 'drop' | 'bubble' | 'cat' | 'star' | 'quill' | 'curtain' | 'shell' | 'eye' | 'wave';
  size?: number | string;
  class?: string;
}
const { name, size = 20, class: cls = '' } = Astro.props;
const s = typeof size === 'number' ? `${size}px` : size;
---

<svg
  class:list={['f-icon', cls]}
  style={`--i:${s}`}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'hat' && (
      <>
        <path d="M8 10h8v6a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2z" />
        <path d="M6 10c0-1.1 2.7-2 6-2s6 .9 6 2-2.7 2-6 2-6-.9-6-2z" />
        <path d="M8.2 12.4h7.6" />
        <path d="M14.6 12.4l2.6-1.1v2.2z" />
      </>
    )
  }
  {
    name === 'mask' && (
      <>
        <path d="M3 8c0-1.7 1.3-3 3-3h12c1.7 0 3 1.3 3 3v3c0 4-2.7 7-6 7h-6c-3.3 0-6-3-6-7z" />
        <path d="M7.5 11.5h2.4M14.1 11.5h2.4" />
        <path d="M10 15.4c1.3 1 2.7 1 4 0" />
      </>
    )
  }
  {
    name === 'note' && (
      <>
        <ellipse cx="7.2" cy="17" rx="3.2" ry="2.4" transform="rotate(-24 7.2 17)" />
        <ellipse cx="17.2" cy="14.6" rx="3.2" ry="2.4" transform="rotate(-24 17.2 14.6)" />
        <path d="M10.4 17V7.4l9.9-2.2v9.4" />
        <path d="M10.4 9.6l9.9-2.2" />
      </>
    )
  }
  {
    name === 'drop' && (
      <>
        <path d="M12 3.4c3 3.6 5.6 6.5 5.6 9.8a5.6 5.6 0 1 1-11.2 0c0-3.3 2.6-6.2 5.6-9.8z" />
        <path d="M9.6 13.6c0 1.6 1 2.6 2.4 2.9" />
      </>
    )
  }
  {
    name === 'bubble' && (
      <>
        <circle cx="10" cy="13" r="6.6" />
        <path d="M7.6 10.4c.9-1.1 2.2-1.6 3.4-1.4" />
        <circle cx="18.6" cy="6.6" r="2.6" />
        <circle cx="19.4" cy="18" r="1.6" />
      </>
    )
  }
  {
    name === 'cat' && (
      <>
        <path d="M5.4 9 4.2 4.6l4 2.3" />
        <path d="M18.6 9l1.2-4.4-4 2.3" />
        <path d="M12 7.2c3.6 0 6.4 2.6 6.4 6 0 3.5-2.9 6.2-6.4 6.2S5.6 16.7 5.6 13.2c0-3.4 2.8-6 6.4-6z" />
        <path d="M9.4 12.6h.9M13.7 12.6h.9" />
        <path d="M11 15.2c.7.6 1.3.6 2 0" />
      </>
    )
  }
  {
    name === 'star' && (
      <>
        <path d="M12 3.4l2.5 5.3 5.6.7-4.1 4 1 5.6L12 16.4 7 19l1-5.6-4.1-4 5.6-.7z" />
      </>
    )
  }
  {
    name === 'quill' && (
      <>
        <path d="M4 20c3.4-1.4 5.6-4.4 6.6-8.4" />
        <path d="M20 3.6c-5.6.6-9.4 3.6-10.6 8.4-1 4 .4 6.4.4 6.4s2.8-2 5.4-5.4C17.6 9.6 20 3.6 20 3.6z" />
        <path d="M11.4 12.4 8.2 15.6" />
      </>
    )
  }
  {
    name === 'curtain' && (
      <>
        <path d="M3 3h18" />
        <path d="M5 3c0 7-.4 12.4-1.6 18" />
        <path d="M9.4 3c0 8-.6 13.6-2 18" />
        <path d="M19 3c0 7 .4 12.4 1.6 18" />
        <path d="M14.6 3c0 8 .6 13.6 2 18" />
      </>
    )
  }
  {
    name === 'shell' && (
      <>
        <path d="M12 20c-4.4 0-8-3.2-8-7.4C4 8.2 7.6 4 12 4s8 4.2 8 8.6c0 4.2-3.6 7.4-8 7.4z" />
        <path d="M12 4v16M8 5.6l1.6 14M16 5.6l-1.6 14" />
        <path d="M4.6 10.4c4.9 1.1 9.9 1.1 14.8 0" />
      </>
    )
  }
  {
    name === 'eye' && (
      <>
        <path d="M2.4 12S6 6.6 12 6.6 21.6 12 21.6 12 18 17.4 12 17.4 2.4 12 2.4 12z" />
        <circle cx="12" cy="12" r="2.8" />
      </>
    )
  }
  {
    name === 'wave' && (
      <>
        <path d="M2 9c2.6 0 4-2.4 6.6-2.4S12.6 9 15.2 9s4-2.4 6.6-2.4" />
        <path d="M2 14c2.6 0 4-2.4 6.6-2.4S12.6 14 15.2 14s4-2.4 6.6-2.4" />
        <path d="M2 19c2.6 0 4-2.4 6.6-2.4S12.6 19 15.2 19s4-2.4 6.6-2.4" />
      </>
    )
  }
</svg>

<style>
  .f-icon {
    width: var(--i);
    height: var(--i);
    display: inline-block;
    vertical-align: -0.18em;
    flex: none;
  }
</style>
