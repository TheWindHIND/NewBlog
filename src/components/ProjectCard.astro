---
/**
 * 项目卡片：整块点开就是项目本身的站点（新窗口）。
 * 数据来自 consts.ts 的 PROJECTS；如果那篇「过程笔记」也在站内，卡片下方再给一个站内入口。
 */
import { mediaUrl } from '../lib/media';

interface Props {
  project: {
    name: string;
    url: string;
    desc?: string;
    tags?: string[];
    cover?: string;
    note?: string;
  };
}
const B = import.meta.env.BASE_URL.replace(/\/+$/, '');
const { project: p } = Astro.props;
const cover = mediaUrl(p.cover);
const host = (() => {
  try {
    return new URL(p.url).host;
  } catch {
    return p.url;
  }
})();
const noteHref = p.note ? `${B}/posts/${p.note}` : null;
---

<article class="project-card">
  <a class="body" href={p.url} target="_blank" rel="noopener noreferrer">
    {cover && <span class="cover" aria-hidden="true" style={`--cover:url("${cover}")`}></span>}
    <div class="meta">
      <span class="kind">项目</span>
      <span class="host">{host}</span>
      <span class="ext" aria-hidden="true">↗</span>
    </div>
    <h3>{p.name}</h3>
    {p.desc && <p class="desc">{p.desc}</p>}
    {
      p.tags && p.tags.length > 0 && (
        <div class="tags">
          {p.tags.map((t) => (
            <span class="tag">#{t}</span>
          ))}
        </div>
      )
    }
  </a>

  {noteHref && <a class="note" href={noteHref}>站内过程笔记 →</a>}

  <!-- 偷看的猫 -->
  <svg class="peek" viewBox="0 0 60 44" aria-hidden="true">
    <path d="M10 22 L4 4 L20 12 Z" fill="currentColor" />
    <path d="M50 22 L56 4 L40 12 Z" fill="currentColor" />
    <circle cx="30" cy="26" r="21" fill="currentColor" />
    <ellipse cx="22" cy="24" rx="3.2" ry="4.4" fill="var(--bg)" />
    <ellipse cx="38" cy="24" rx="3.2" ry="4.4" fill="var(--bg)" />
    <ellipse cx="22" cy="25" rx="1.4" ry="3.4" fill="currentColor" />
    <ellipse cx="38" cy="25" rx="1.4" ry="3.4" fill="currentColor" />
    <ellipse cx="14" cy="32" rx="3.4" ry="2" fill="var(--accent-2)" opacity="0.5" />
    <ellipse cx="46" cy="32" rx="3.4" ry="2" fill="var(--accent-2)" opacity="0.5" />
  </svg>
</article>

<style>
  .project-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.35s var(--ease-water), border-color 0.35s, background 0.35s;
  }
  .project-card:hover {
    transform: translateY(-6px);
    border-color: var(--border-strong);
    background: var(--bg-card-hover);
  }
  .body {
    display: block;
    padding: 22px 22px 16px;
    color: inherit;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .kind {
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--border);
    padding: 0 9px;
    border-radius: 999px;
    letter-spacing: 0.1em;
  }
  .host {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ext {
    margin-left: auto;
    font-size: 0.95rem;
    color: var(--accent-2);
    transition: transform 0.35s var(--ease-water);
  }
  .project-card:hover .ext {
    transform: translate(2px, -2px);
  }
  /* 封面带：溢出下缘用遮罩淡出（只改 alpha），昼夜两套底色都不留硬缝 */
  .cover {
    display: block;
    height: 132px;
    margin: -22px -22px 16px;
    background-image: var(--cover);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transform-origin: 50% 20%;
    transition: transform 0.55s var(--ease-water);
    -webkit-mask-image: linear-gradient(180deg, #000 0 58%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0 58%, transparent 100%);
  }
  .project-card:hover .cover {
    transform: scale(1.045);
  }
  h3 {
    margin-top: 8px;
    font-size: 1.18rem;
  }
  .desc {
    margin-top: 6px;
    font-size: 0.9rem;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tags {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    font-size: 0.76rem;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 1px 9px;
    border-radius: 999px;
  }
  /* 站内过程笔记：卡片里的第二个入口，所以不套在整块外链里 */
  .note {
    display: inline-block;
    margin: 0 22px 18px;
    font-size: 0.8rem;
    color: var(--accent-2);
    border-bottom: 1px dashed var(--border-strong);
    transition: border-color 0.3s, color 0.3s;
  }
  .note:hover {
    border-color: var(--accent-2);
  }
  /* 偷看的猫：默认藏在卡片右下缘外 */
  .peek {
    position: absolute;
    right: 14px;
    bottom: -16px;
    width: 44px;
    color: var(--accent);
    opacity: 0;
    transform: translateY(12px);
    transition: all 0.35s var(--ease-water);
  }
  .project-card:hover .peek {
    opacity: 1;
    transform: translateY(-8px);
  }
</style>
