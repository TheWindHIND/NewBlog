---
/**
 * 页首渐隐插画带（文章页 / 文章列表页共用）
 *
 *  - `.post-bg`：插画本体。用 `mask-image` 做上淡入、下淡出（遮罩只影响 alpha，
 *    不会像「主题色→透明」渐变那样在 sRGB 插值里混出灰带）；透明度走 tokens：
 *    文章页 `--post-img-o` / 列表页 `--post-list-img-o`（昼夜各自一套）。
 *  - `.post-veil`：主题色柔光纱，压住页头标题区，上缘实、往下自然散开，不留矩形硬边。
 *
 * 两者都是 `position:absolute; z-index:-1`，所以**必须放在页面内容的最前面**。
 */
import { mediaUrl } from '../lib/media';

interface Props {
  /** background-position，用来把画面主体推到不挡正文的一侧 */
  position?: string;
  /**
   * 版式：`page` = 文章内页（正文直接压在图上，图要更淡）；
   * `list` = 列表页（正文是卡片，底图可以多露一点）→ 换用 `--post-list-*` 令牌。
   */
  variant?: 'page' | 'list';
  /** 本篇专属插画（frontmatter 的 bg）：覆盖主题令牌里的 --post-bg */
  bg?: string;
  /** 亮色插画档位（frontmatter 的 bgTone） */
  tone?: 'auto' | 'bright';
}
const { position, variant = 'page', bg, tone = 'auto' } = Astro.props;
const isList = variant === 'list';
const isBright = tone === 'bright';
/** 亮色插画多为对称构图（走廊之类），居中取景比偏移好看 */
const pos = position ?? (isBright ? '50% 46%' : '68% 30%');
const img = mediaUrl(bg);
---

<div
  class:list={['post-bg', { 'is-list': isList, 'tone-bright': isBright }]}
  style={`--post-bg-pos:${pos}${img ? `;--post-bg:url("${img}")` : ''}`}
  aria-hidden="true"
></div>
<div class:list={['post-veil', { 'is-list': isList, 'tone-bright': isBright }]} aria-hidden="true"></div>

<style>
  /* 文章很长，所以不做「固定铺满整屏」（读到下面还透图会伤可读性），
     改成页首一条**渐隐的插画带**：上缘淡入、下缘淡出，正文落到主题底色上。 */
  .post-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: min(92vh, 820px);
    z-index: -1;
    background-image: var(--post-bg);
    background-size: cover;
    background-position: var(--post-bg-pos, 68% 30%);
    background-repeat: no-repeat;
    opacity: var(--post-img-o, 0.5);
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 16%, #000 58%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 16%, #000 58%, transparent 100%);
  }
  .post-bg.is-list {
    opacity: var(--post-list-img-o, var(--post-img-o, 0.5));
  }
  .post-veil {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: min(92vh, 820px);
    z-index: -1;
    background: var(--bg);
    opacity: var(--post-veil-o, 0.9);
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 15%, transparent 58%);
    mask-image: linear-gradient(180deg, #000 0%, #000 15%, transparent 58%);
  }
  .post-veil.is-list {
    opacity: var(--post-list-veil-o, var(--post-veil-o, 0.9));
  }
  /* 亮色插画（整张发白）：夜主题下默认那层主题纱会把它糊成一团黑，
     所以换一套更「多露图、少压纱」的令牌——文字仍是浅色，靠纱压住标题区即可。
     同时把画面主体往下挪一点，别让最亮的部分正好顶在标题后面。 */
  .post-bg.tone-bright {
    opacity: var(--post-bright-img-o, 0.7);
  }
  .post-veil.tone-bright {
    opacity: var(--post-bright-veil-o, 0.45);
    /* 亮图的纱要压得更深一点：默认遮罩的实心区只到 15%，
       而标题/日期正好落在 20% 上下，会被亮图顶掉对比度 */
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 30%, transparent 72%);
    mask-image: linear-gradient(180deg, #000 0%, #000 30%, transparent 72%);
  }
</style>
