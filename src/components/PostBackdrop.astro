---
/**
 * 页首渐隐插画带（文章页 / 文章列表页共用）
 *
 *  - `.post-bg`：插画本体。用 `mask-image` 做上淡入、下淡出（遮罩只影响 alpha，
 *    不会像「主题色→透明」渐变那样在 sRGB 插值里混出灰带）；透明度走 tokens：
 *    文章页 `--post-img-o` / 列表页 `--post-list-img-o`（昼夜各自一套）。
 *  - `.post-veil`：主题色柔光纱，压住页头标题区，上缘实、往下自然散开，不留矩形硬边。
 *  - 档位 `tone`（frontmatter 的 bgTone）：
 *      `auto`   主题默认令牌；
 *      `bright` 亮色插画（整张发白）——夜主题默认纱会把它压没，换 --post-bright-*；
 *      `dark`   很暗的插画——默认纱下只剩一层黑，换 --post-dark-*（少压纱、多露图）。
 *  - **主题配对图** `bgDay`（frontmatter 的 bgDay）：芒主题时把插画整张换掉（如归档页那样昼夜两张）。
 *    档位也按主题分开取：荒用 `tone`，芒用 `toneDay`（缺省跟随 `tone`）。
 *
 * 两者都是 `position:absolute; z-index:-1`，所以**必须放在页面内容的最前面**。
 */
import { mediaUrl } from '../lib/media';

type Tone = 'auto' | 'bright' | 'dark';

interface Props {
  /** background-position，用来把画面主体推到不挡正文的一侧 */
  position?: string;
  /** 芒（昼）主题下的 background-position，缺省跟随 position */
  positionDay?: string;
  /**
   * 版式：`page` = 文章内页（正文直接压在图上，图要更淡）；
   * `list` = 列表页（正文是卡片，底图可以多露一点）→ 换用 `--post-list-*` 令牌。
   */
  variant?: 'page' | 'list';
  /** 插画（frontmatter 的 bg）：荒主题 / 默认用这张 */
  bg?: string;
  /** 上面那张的档位（frontmatter 的 bgTone） */
  tone?: Tone;
  /** 主题配对插画（frontmatter 的 bgDay）：芒主题时换成这张 */
  bgDay?: string;
  /** 配对图的档位（frontmatter 的 bgDayTone），缺省跟随 tone */
  toneDay?: Tone;
}
const { position, positionDay, variant = 'page', bg, tone = 'auto', bgDay, toneDay } = Astro.props;
const isList = variant === 'list';
/** 档位 → 默认取景：亮/暗插画多是居中构图的插画，别沿用主题默认那个偏右的取景 */
const POS: Record<Tone, string> = { auto: '68% 30%', bright: '50% 46%', dark: '50% 42%' };
const dayTone: Tone = toneDay ?? tone;
const pos = position ?? POS[tone];
const posDay = positionDay ?? position ?? POS[dayTone];
const night = bg === 'none' ? undefined : mediaUrl(bg);
const day = bgDay === 'none' ? undefined : mediaUrl(bgDay);

/** 档位类名按主题分开写死（scoped 样式只认字面量，拼出来的类名不会被编译） */
const themeCls = [
  tone !== 'auto' ? `t-ousia-${tone}` : '',
  dayTone !== 'auto' ? `t-pneuma-${dayTone}` : '',
].filter(Boolean);

const style = [
  `--post-bg-pos:${pos}`,
  `--post-day-bg-pos:${posDay}`,
  // `bg: 'none'` = 这篇不要插画带。必须显式写 none 覆盖：不写的话会回落到
  // tokens.css 里主题默认的 --post-bg（那张秋千少女），看起来像没生效。
  bg === 'none' ? '--post-bg:none' : night ? `--post-bg:url("${night}")` : '',
  bgDay === 'none' ? '--post-day-bg:none' : day ? `--post-day-bg:url("${day}")` : '',
]
  .filter(Boolean)
  .join(';');
---

<div
  class:list={['post-bg', { 'is-list': isList }, themeCls]}
  style={style}
  aria-hidden="true"
></div>
<div class:list={['post-veil', { 'is-list': isList }, themeCls]} aria-hidden="true"></div>

<style>
  /* 文章很长，所以不做「固定铺满整屏」（读到下面还透图会伤可读性），
     改成页首一条**渐隐的插画带**：上缘淡入、下缘淡出，正文落到主题底色上。 */
  .post-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: min(92vh, 820px);
    z-index: -1;
    background-image: var(--post-bg);
    background-size: cover;
    background-position: var(--post-bg-pos, 68% 30%);
    background-repeat: no-repeat;
    opacity: var(--post-img-o, 0.5);
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 16%, #000 58%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 16%, #000 58%, transparent 100%);
  }
  .post-bg.is-list {
    opacity: var(--post-list-img-o, var(--post-img-o, 0.5));
  }
  .post-veil {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: min(92vh, 820px);
    z-index: -1;
    background: var(--bg);
    opacity: var(--post-veil-o, 0.9);
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 15%, transparent 58%);
    mask-image: linear-gradient(180deg, #000 0%, #000 15%, transparent 58%);
  }
  .post-veil.is-list {
    opacity: var(--post-list-veil-o, var(--post-veil-o, 0.9));
  }
  /* ---- 主题配对图：芒主题整张换掉（位置也跟着换） ---- */
  :root[data-theme='pneuma'] .post-bg {
    background-image: var(--post-day-bg, var(--post-bg));
    background-position: var(--post-day-bg-pos, var(--post-bg-pos, 68% 30%));
  }
  /* ---- 档位：按主题分别挂（同一元素上可能同时有荒/芒两套档位类，靠主题限定只生效一套） ---- */
  :root[data-theme='ousia'] .post-bg.t-ousia-bright,
  :root[data-theme='pneuma'] .post-bg.t-pneuma-bright {
    opacity: var(--post-bright-img-o, 0.7);
  }
  :root[data-theme='ousia'] .post-veil.t-ousia-bright,
  :root[data-theme='pneuma'] .post-veil.t-pneuma-bright {
    opacity: var(--post-bright-veil-o, 0.45);
    /* 亮图的纱要压得更深一点：默认遮罩的实心区只到 15%，
       而标题/日期正好落在 20% 上下，会被亮图顶掉对比度 */
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 30%, transparent 72%);
    mask-image: linear-gradient(180deg, #000 0%, #000 30%, transparent 72%);
  }
  :root[data-theme='ousia'] .post-bg.t-ousia-dark,
  :root[data-theme='pneuma'] .post-bg.t-pneuma-dark {
    opacity: var(--post-dark-img-o, 0.78);
    /* 暗图敢露得多，是因为它压得住浅色字；但暗图里常有**亮主体的插画**（人像、灯光），
       正文落在这一段上会顶掉对比度 → 把图的淡出提前到正文起笔之前（标签行之上就收干净），
       只在页首标题那一带给足画面。（实测：《电子皮肤》那张的人像正好压在页首引言上） */
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 12%, #000 22%, transparent 40%);
    mask-image: linear-gradient(180deg, transparent 0, #000 12%, #000 22%, transparent 40%);
  }
  :root[data-theme='ousia'] .post-veil.t-ousia-dark,
  :root[data-theme='pneuma'] .post-veil.t-pneuma-dark {
    opacity: var(--post-dark-veil-o, 0.45);
  }
</style>
