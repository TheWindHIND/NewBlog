---
/** 首页全屏 hero：背景插画 + 泡泡粒子 Canvas（泡泡里偶尔有猫剪影） */
---

<div class="hero-canvas" aria-hidden="true">
  <canvas data-bubbles></canvas>
</div>

<style>
  .hero-canvas {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-bubbles]');
  if (canvas && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      let w = 0;
      let h = 0;
      const dpr = Math.min(devicePixelRatio || 1, 2);

      const resize = () => {
        w = canvas.clientWidth;
        h = canvas.clientHeight;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };
      resize();
      addEventListener('resize', resize, { passive: true });

      type Bubble = { x: number; y: number; r: number; v: number; ph: number; cat: boolean };
      const spawn = (): Bubble => ({
        x: Math.random() * w,
        y: h + 30 + Math.random() * 60,
        r: 3 + Math.random() * 11,
        v: 0.25 + Math.random() * 0.5,
        ph: Math.random() * Math.PI * 2,
        cat: Math.random() < 0.14,
      });
      const count = () => Math.round(Math.min(26, Math.max(9, w / 55)));
      let bubbles: Bubble[] = Array.from({ length: count() }, spawn);
      bubbles.forEach((b) => (b.y = Math.random() * h)); // 初始铺满全屏

      let t = 0;
      const draw = () => {
        t += 0.016;
        ctx.clearRect(0, 0, w, h);
        for (const b of bubbles) {
          b.y -= b.v;
          b.x += Math.sin(t * 0.9 + b.ph) * 0.3;
          if (b.y < -30) Object.assign(b, spawn());

          const grad = ctx.createRadialGradient(
            b.x - b.r * 0.35, b.y - b.r * 0.35, b.r * 0.1,
            b.x, b.y, b.r
          );
          grad.addColorStop(0, 'rgba(255,255,255,0.45)');
          grad.addColorStop(1, 'rgba(140,210,240,0.06)');
          ctx.beginPath();
          ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);
          ctx.fillStyle = grad;
          ctx.fill();
          ctx.strokeStyle = 'rgba(255,255,255,0.3)';
          ctx.lineWidth = 1;
          ctx.stroke();

          if (b.cat) {
            // 泡泡里的猫耳朵剪影
            ctx.beginPath();
            ctx.moveTo(b.x - b.r * 0.65, b.y - b.r * 0.4);
            ctx.lineTo(b.x - b.r * 0.28, b.y - b.r * 1.05);
            ctx.lineTo(b.x - b.r * 0.02, b.y - b.r * 0.5);
            ctx.moveTo(b.x + b.r * 0.65, b.y - b.r * 0.4);
            ctx.lineTo(b.x + b.r * 0.28, b.y - b.r * 1.05);
            ctx.lineTo(b.x + b.r * 0.02, b.y - b.r * 0.5);
            ctx.strokeStyle = 'rgba(255,255,255,0.55)';
            ctx.stroke();
          }
        }
        requestAnimationFrame(draw);
      };
      requestAnimationFrame(draw);
    }
  }
</script>
