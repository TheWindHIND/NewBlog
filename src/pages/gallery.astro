---
/**
 * 图库：剧院长廊
 * 每张照片是一幅挂进金色画框的展品；点击展开为全屏「舞台」灯箱。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Ornament from '../components/Ornament.astro';
import { getCollection } from 'astro:content';

const B = import.meta.env.BASE_URL.replace(/\/+$/, '');
const items = (await getCollection('gallery')).sort(
  (a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)
);
const groups = [...new Set(items.map((i) => i.data.group))];
---

<BaseLayout title="图库" description="藏枫的猫窝的剧院长廊——照片与画">
  <section class="container">
    <header class="playbill">
      <span class="pb-icon"><Icon name="shell" size={30} /></span>
      <p class="pb-kicker">GALLERY · 剧院长廊</p>
      <h1 class="pb-title">墙上的风景</h1>
      <p class="pb-sub">每一幅都挂着金色画框。点击即可推近观看，← → 换一幅，Esc 退场。</p>
    </header>

    {
      groups.map((g) => (
        <section class="hall">
          <h2 class="hall-title">
            <Icon name="curtain" size={16} />
            <span>{g}</span>
          </h2>
          <div class="wall">
            {items
              .filter((i) => i.data.group === g)
              .map((i) => (
                <figure class="frame" data-lightbox-item data-src={i.data.src} data-alt={i.data.alt}>
                  <span class="frame-inner">
                    <img src={i.data.src} alt={i.data.alt} loading="lazy" />
                  </span>
                  <figcaption>{i.data.alt}</figcaption>
                </figure>
              ))}
          </div>
        </section>
      ))
    }

    <Ornament motif="star" label="谢幕" />
  </section>

  <!-- 全屏灯箱 -->
  <div class="lightbox" data-lightbox hidden>
    <div class="lb-stage">
      <img data-lb-img src="" alt="" />
      <p class="lb-caption" data-lb-caption></p>
      <p class="lb-count" data-lb-count></p>
    </div>
    <button class="lb-btn lb-close" data-lb-close aria-label="关闭">
      <Icon name="wave" size={20} />
    </button>
    <button class="lb-btn lb-prev" data-lb-prev aria-label="上一幅">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button class="lb-btn lb-next" data-lb-next aria-label="下一幅">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>
</BaseLayout>

<style>
  .container {
    padding-block: 40px 20px;
  }

  /* ---------- 节目单式页头 ---------- */
  .playbill {
    text-align: center;
    padding: 26px 20px 22px;
    border: 1px solid var(--frame-line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(ellipse 70% 120% at 50% 0%, var(--accent-soft), transparent 70%),
      var(--bg-card);
    position: relative;
  }
  .playbill::before,
  .playbill::after {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid var(--ornament);
    border-radius: calc(var(--radius-lg) - 6px);
    opacity: 0.35;
    pointer-events: none;
  }
  .playbill::after {
    inset: 10px;
    opacity: 0.18;
  }
  .pb-icon {
    display: inline-flex;
    color: var(--accent-2);
  }
  .pb-kicker {
    margin-top: 8px;
    font-size: 0.72rem;
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    color: var(--muted);
  }
  .pb-title {
    margin-top: 8px;
    font-family: var(--font-hand);
    font-size: clamp(1.6rem, 4.4vw, 2.3rem);
    letter-spacing: 0.16em;
  }
  .pb-sub {
    margin-top: 10px;
    font-size: 0.88rem;
    color: var(--muted);
  }

  /* ---------- 展厅 ---------- */
  .hall {
    margin-top: 44px;
  }
  .hall-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--accent);
  }
  .hall-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--ornament), transparent);
    opacity: 0.6;
  }
  .wall {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 26px;
  }

  /* ---------- 金色画框 ---------- */
  .frame {
    margin: 0;
    cursor: zoom-in;
    transition: transform 0.35s var(--ease-water);
  }
  .frame:hover {
    transform: translateY(-5px);
  }
  .frame-inner {
    display: block;
    position: relative;
    padding: 9px;
    border: 1px solid var(--ornament);
    border-radius: 4px;
    background: var(--bg-card);
    box-shadow: var(--shadow);
  }
  .frame-inner::after {
    content: '';
    position: absolute;
    inset: -4px;
    border: 1px solid var(--ornament);
    border-radius: 7px;
    opacity: 0.4;
    pointer-events: none;
  }
  .frame img {
    width: 100%;
    border-radius: 2px;
    display: block;
  }
  .frame figcaption {
    margin-top: 10px;
    text-align: center;
    font-family: var(--font-hand);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  /* ---------- 全屏灯箱 ---------- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 400;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 4vw, 64px);
    background: rgba(5, 10, 20, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 50% 42%, rgba(120, 200, 240, 0.14), transparent 70%);
    pointer-events: none;
  }
  .lb-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 100%;
    max-height: 100%;
    animation: lb-in 0.42s var(--ease-water) both;
  }
  @keyframes lb-in {
    from { opacity: 0; transform: scale(0.96) translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  .lb-stage img {
    max-width: min(86vw, 1200px);
    max-height: 76vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    border: 1px solid rgba(232, 200, 122, 0.5);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.6);
  }
  .lb-caption {
    font-family: var(--font-hand);
    color: #e6eef7;
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    text-align: center;
  }
  .lb-count {
    position: absolute;
    top: -30px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.76rem;
    letter-spacing: 0.24em;
    color: rgba(230, 238, 247, 0.6);
  }
  .lb-btn {
    position: fixed;
    color: #ecf4fb;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    transition: background 0.25s, transform 0.25s var(--ease-water);
  }
  .lb-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    transform: scale(1.08);
  }
  .lb-btn svg {
    width: 26px;
    height: 26px;
  }
  .lb-close {
    top: clamp(14px, 3vw, 30px);
    right: clamp(14px, 3vw, 30px);
  }
  .lb-prev {
    left: clamp(10px, 3vw, 34px);
    top: 50%;
    margin-top: -26px;
  }
  .lb-next {
    right: clamp(10px, 3vw, 34px);
    top: 50%;
    margin-top: -26px;
  }
  @media (max-width: 640px) {
    .lb-prev { left: 8px; }
    .lb-next { right: 8px; }
    .lb-stage img { max-width: 92vw; max-height: 66vh; }
  }
</style>

<script>
  const box = document.querySelector<HTMLElement>('[data-lightbox]');
  const img = document.querySelector<HTMLImageElement>('[data-lb-img]');
  const caption = document.querySelector('[data-lb-caption]');
  const counter = document.querySelector('[data-lb-count]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-lightbox-item]')];
  let idx = 0;

  if (box && img && items.length) {
    const show = (i: number) => {
      idx = (i + items.length) % items.length;
      const el = items[idx];
      img.src = el.dataset.src ?? '';
      img.alt = el.dataset.alt ?? '';
      if (caption) caption.textContent = el.dataset.alt ?? '';
      if (counter) counter.textContent = `第 ${idx + 1} 幅 / 共 ${items.length} 幅`;
    };
    const open = (i: number) => {
      show(i);
      box.hidden = false;
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      box.hidden = true;
      document.body.style.overflow = '';
    };

    items.forEach((el, i) => el.addEventListener('click', () => open(i)));
    document.querySelector('[data-lb-close]')?.addEventListener('click', close);
    document.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(idx - 1));
    document.querySelector('[data-lb-next]')?.addEventListener('click', () => show(idx + 1));
    box.addEventListener('click', (e) => {
      if (e.target === box) close();
    });
    addEventListener('keydown', (e) => {
      if (box.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
  }
</script>
