---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const B = import.meta.env.BASE_URL.replace(/\/+$/, '');
const items = (await getCollection('gallery')).sort(
  (a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)
);
const groups = [...new Set(items.map((i) => i.data.group))];
---

<BaseLayout title="图库" description="藏枫的猫窝的相册墙">
  <section class="container">
    <h1 class="page-title">📷 图库</h1>
    <p class="sub">点击任意照片放大浏览，← → 切换，Esc 关闭。</p>

    {
      groups.map((g) => (
        <section class="group">
          <h2>{g}</h2>
          <div class="wall">
            {items
              .filter((i) => i.data.group === g)
              .map((i, gi) => (
                <figure data-lightbox-item data-src={i.data.src} data-alt={i.data.alt}>
                  <img src={i.data.src} alt={i.data.alt} loading="lazy" />
                  <figcaption>{i.data.alt}</figcaption>
                </figure>
              ))}
          </div>
        </section>
      ))
    }
  </section>

  <dialog data-lightbox>
    <button class="lb-close" data-lb-close aria-label="关闭">×</button>
    <button class="lb-nav lb-prev" data-lb-prev aria-label="上一张">‹</button>
    <img data-lb-img src="" alt="" />
    <button class="lb-nav lb-next" data-lb-next aria-label="下一张">›</button>
    <p class="lb-caption" data-lb-caption></p>
  </dialog>
</BaseLayout>

<style>
  .container {
    padding-block: 44px 20px;
  }
  .page-title {
    font-size: 1.7rem;
  }
  .sub {
    color: var(--muted);
    margin: 8px 0 10px;
  }
  .group {
    margin-top: 28px;
  }
  .group h2 {
    font-family: var(--font-hand);
    color: var(--accent);
    font-size: 1.15rem;
    letter-spacing: 0.15em;
  }
  .wall {
    margin-top: 14px;
    columns: 3 260px;
    column-gap: 16px;
  }
  figure {
    break-inside: avoid;
    margin: 0 0 16px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    cursor: zoom-in;
    background: var(--bg-card);
    transition: transform 0.3s var(--ease-water), border-color 0.3s;
  }
  figure:hover {
    transform: translateY(-4px) scale(1.01);
    border-color: var(--border-strong);
  }
  img {
    width: 100%;
  }
  figcaption {
    padding: 8px 12px;
    font-size: 0.8rem;
    color: var(--muted);
  }

  dialog {
    border: none;
    padding: 0;
    background: transparent;
    max-width: min(92vw, 1100px);
  }
  dialog::backdrop {
    background: rgba(5, 10, 20, 0.82);
    backdrop-filter: blur(6px);
  }
  dialog img {
    max-width: 100%;
    max-height: 82vh;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .lb-close {
    position: absolute;
    top: -44px;
    right: 0;
    color: #fff;
    font-size: 1.8rem;
  }
  .lb-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: #fff;
    font-size: 2.6rem;
    padding: 12px 18px;
    opacity: 0.7;
  }
  .lb-nav:hover {
    opacity: 1;
  }
  .lb-prev { left: -60px; }
  .lb-next { right: -60px; }
  .lb-caption {
    text-align: center;
    color: #cfd8e3;
    font-size: 0.88rem;
    margin-top: 12px;
  }
  @media (max-width: 720px) {
    .lb-prev { left: 4px; }
    .lb-next { right: 4px; }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const img = document.querySelector<HTMLImageElement>('[data-lb-img]');
  const caption = document.querySelector('[data-lb-caption]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-lightbox-item]')];
  let idx = 0;

  if (dialog && img) {
    const show = (i: number) => {
      idx = (i + items.length) % items.length;
      const el = items[idx];
      img.src = el.dataset.src ?? '';
      img.alt = el.dataset.alt ?? '';
      if (caption) caption.textContent = el.dataset.alt ?? '';
    };
    items.forEach((el, i) =>
      el.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      })
    );
    document.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    document.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(idx - 1));
    document.querySelector('[data-lb-next]')?.addEventListener('click', () => show(idx + 1));
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
  }
</script>
