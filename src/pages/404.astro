---
import BaseLayout from '../layouts/BaseLayout.astro';
import Live2DCat from '../components/Live2DCat.astro';
import Icon from '../components/Icon.astro';

const B = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<BaseLayout title="404 · 迷路的猫">
  <section class="lost container">
    <div class="lost-bubbles" aria-hidden="true">
      <i></i><i></i><i></i><i></i>
    </div>
    <Live2DCat size="clamp(150px, 24vw, 220px)" class="lost-cat" />

    <h1>404 · 这只猫迷路了</h1>
    <p class="msg">泡泡飘走了，页面也不见了。要不要看看别处？</p>
    <div class="actions">
      <a class="btn" href={`${B}/`}>回猫窝</a>
      <a class="btn ghost" href={`${B}/random`}>
        随机去个地方
        <Icon name="star" size={15} />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    min-height: calc(100svh - var(--nav-h) - 120px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 10px;
    position: relative;
  }
  .lost-cat {
    filter: drop-shadow(0 14px 30px rgba(0, 0, 0, 0.34));
  }
  .lost-bubbles {
    position: absolute;
    top: 12%;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 90px;
    pointer-events: none;
  }
  .lost-bubbles i {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1.4px solid var(--accent);
    animation: lost-bub 4.4s var(--ease-water) infinite;
  }
  .lost-bubbles i:nth-child(2) { width: 7px; height: 7px; animation-delay: 0.7s; }
  .lost-bubbles i:nth-child(3) { width: 16px; height: 16px; animation-delay: 1.5s; }
  .lost-bubbles i:nth-child(4) { width: 9px; height: 9px; animation-delay: 2.3s; }
  @keyframes lost-bub {
    0% { transform: translateY(30px) scale(0.6); opacity: 0; }
    35% { opacity: 0.7; }
    100% { transform: translateY(-90px) scale(1); opacity: 0; }
  }
  h1 {
    font-size: 1.6rem;
    font-family: var(--font-hand);
    letter-spacing: 0.1em;
  }
  .msg {
    color: var(--muted);
  }
  .actions {
    margin-top: 18px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 26px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    transition: transform 0.25s var(--ease-water);
  }
  .btn:hover {
    transform: translateY(-3px);
    color: var(--bg);
  }
  .btn.ghost {
    background: var(--bg-card);
    color: var(--text-strong);
    border: 1px solid var(--border-strong);
  }
</style>

<script>
  import { catnest } from '../scripts/catnest';
  catnest.unlock('lost-cat');
</script>
