---
import BaseLayout from '../layouts/BaseLayout.astro';

const B = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<BaseLayout title="404 · 迷路的猫">
  <section class="lost container">
    <svg viewBox="0 0 200 160" class="cat" aria-hidden="true">
      <!-- 泡泡 -->
      <circle cx="40" cy="30" r="10" fill="none" stroke="var(--accent)" opacity="0.4" />
      <circle cx="170" cy="50" r="7" fill="none" stroke="var(--accent)" opacity="0.3" />
      <circle cx="150" cy="18" r="4" fill="none" stroke="var(--accent)" opacity="0.35" />
      <circle cx="24" cy="70" r="5" fill="none" stroke="var(--accent)" opacity="0.25" />
      <!-- 猫（问号尾巴） -->
      <g transform="translate(100,100)">
        <path d="M38 18 Q 66 22 60 -8 Q 57 -24 44 -22" fill="none" stroke="currentColor" stroke-width="9" stroke-linecap="round" class="tail" />
        <ellipse cx="0" cy="28" rx="36" ry="22" fill="currentColor" />
        <g transform="translate(-6,-22)">
          <path d="M-21 -12 L-27 -34 L-7 -22 Z" fill="currentColor" />
          <path d="M21 -12 L27 -34 L7 -22 Z" fill="currentColor" />
          <circle cx="0" cy="0" r="23" fill="currentColor" />
          <ellipse cx="-8.5" cy="-2" rx="3.4" ry="4.8" fill="var(--bg)" />
          <ellipse cx="8.5" cy="-2" rx="3.4" ry="4.8" fill="var(--bg)" />
          <ellipse cx="-8.5" cy="-1" rx="1.5" ry="3.6" fill="#1b1b1f" />
          <ellipse cx="8.5" cy="-1" rx="1.5" ry="3.6" fill="#1b1b1f" />
          <ellipse cx="-15" cy="6" rx="3.8" ry="2.2" fill="var(--accent-2)" opacity="0.5" />
          <ellipse cx="15" cy="6" rx="3.8" ry="2.2" fill="var(--accent-2)" opacity="0.5" />
          <path d="M-2.5 8 Q0 10.5 2.5 8" fill="none" stroke="#1b1b1f" stroke-width="1.5" stroke-linecap="round" />
        </g>
      </g>
    </svg>

    <h1>404 · 这只猫迷路了</h1>
    <p class="msg">泡泡飘走了，页面也不见了。要不要看看别处？</p>
    <div class="actions">
      <a class="btn" href={`${B}/`}>回猫窝</a>
      <a class="btn ghost" href={`${B}/random`}>随机去个地方 🎲</a>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    min-height: calc(100svh - var(--nav-h) - 120px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 10px;
  }
  .cat {
    width: 190px;
    color: var(--text);
    opacity: 0.95;
  }
  .tail {
    transform-origin: 138px 118px;
    animation: tail-wag 3s var(--ease-water) infinite;
  }
  @keyframes tail-wag {
    0%, 100% { transform: rotate(0deg); }
    40% { transform: rotate(10deg); }
    70% { transform: rotate(-6deg); }
  }
  h1 {
    font-size: 1.6rem;
  }
  .msg {
    color: var(--muted);
  }
  .actions {
    margin-top: 18px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .btn {
    padding: 10px 26px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    transition: transform 0.25s var(--ease-water);
  }
  .btn:hover {
    transform: translateY(-3px);
    color: var(--bg);
  }
  .btn.ghost {
    background: var(--bg-card);
    color: var(--text-strong);
    border: 1px solid var(--border-strong);
  }
</style>

<script>
  import { catnest } from '../scripts/catnest';
  catnest.unlock('lost-cat');
</script>
