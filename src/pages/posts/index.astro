---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostBackdrop from '../../components/PostBackdrop.astro';
import PostCard from '../../components/PostCard.astro';
import Playbill from '../../components/Playbill.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => (import.meta.env.PROD ? !data.draft : true))).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
---

<BaseLayout title="文章" description="藏枫的猫窝的全部文章，按年份归档。">
  {/* 与文章内页同一张背景插画带（列表页正文是卡片，底图多露一点、纱层更透） */}
  <PostBackdrop variant="list" position="74% 22%" />
  <section class="container">
    <Playbill
      kicker="ALL ARTICLES"
      title="全部剧目"
      sub={`共 ${posts.length} 篇 · 按年份分幕`}
      motif="quill"
    />

    {
      [...byYear.entries()].map(([year, list]) => (
        <section class="year-group">
          <h2 class="year">
            <Icon name="curtain" size={15} />
            <span>{year}</span>
            <em>{list.length} 篇</em>
          </h2>
          <div class="grid">
            {list.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </section>
      ))
    }
  </section>
</BaseLayout>

<style>
  .container {
    padding-block: 40px 20px;
  }
  .year-group {
    margin-top: 38px;
  }
  .year {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.05rem;
    color: var(--accent);
    font-family: var(--font-hand);
    letter-spacing: 0.2em;
  }
  .year::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--ornament), transparent);
    opacity: 0.55;
  }
  .year em {
    font-style: normal;
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--muted);
    order: 3;
  }
  .year span {
    order: 1;
  }
  .year svg {
    order: 0;
  }
  .year::after {
    order: 2;
  }
  .grid {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
</style>
