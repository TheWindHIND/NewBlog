---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostBackdrop from '../../components/PostBackdrop.astro';
import PostCard from '../../components/PostCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import Playbill from '../../components/Playbill.astro';
import Ornament from '../../components/Ornament.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import { PROJECTS, POST_QUOTES } from '../../consts';

const posts = (await getCollection('posts', ({ data }) => (import.meta.env.PROD ? !data.draft : true))).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

/** 项目门口放着的是「作品」本身（点开即去对方站点），它们的写法/来龙去脉则作为文章收在下面按年份归档 */
const projects = PROJECTS;

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
---

<BaseLayout title="文章" description="藏枫的猫窝的全部文章——项目与杂谈，按年份归档。">
  {/* 与文章内页同一张背景插画带（列表页正文是卡片，底图多露一点、纱层更透） */}
  <PostBackdrop variant="list" position="74% 22%" />
  <section class="container">
    <Playbill
      kicker="ALL ARTICLES"
      title="全部剧目"
      sub={`项目 ${projects.length} · 杂谈 ${posts.length} · 语录 ${POST_QUOTES.length}`}
      motif="quill"
    />

    {
      projects.length > 0 && (
        <section class="board board--projects">
          <h2 class="board-title">
            <Icon name="star" size={16} />
            <span>项目</span>
            <em>PROJECTS · {projects.length}</em>
          </h2>
          <p class="board-sub">自己搭的东西——做完了、能访问。点开就是它本身；怎么做的，写在下面的杂谈里。</p>
          <div class="grid">
            {projects.map((p) => (
              <ProjectCard project={p} />
            ))}
          </div>
        </section>
      )
    }

    {
      POST_QUOTES.length > 0 && (
        <section class="board board--quotes" id="quotes">
          <h2 class="board-title">
            <Icon name="bubble" size={16} />
            <span>语录</span>
            <em>WHISPERS · {POST_QUOTES.length}</em>
          </h2>
          <p class="board-sub">路过的台词——一句话，一个日期，不连成剧。</p>
          <div class="qgrid">
            {POST_QUOTES.map((q) => (
              <QuoteCard q={q} />
            ))}
          </div>
        </section>
      )
    }

    {
      posts.length > 0 && (
        <section class="board">
          <h2 class="board-title">
            <Icon name="quill" size={16} />
            <span>杂谈</span>
            <em>ESSAYS · {posts.length}</em>
          </h2>
          {[...byYear.entries()].map(([year, list]) => (
            <section class="year-group">
              <h3 class="year">
                <Icon name="curtain" size={15} />
                <span>{year}</span>
                <em>{list.length} 篇</em>
              </h3>
              <div class="grid">
                {list.map((post) => (
                  <PostCard post={post} />
                ))}
              </div>
            </section>
          ))}
        </section>
      )
    }

    <Ornament motif="star" label="谢幕" />
  </section>
</BaseLayout>

<style>
  .container {
    padding-block: 40px 20px;
  }
  .board {
    margin-top: 44px;
  }
  .board-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.25rem;
    color: var(--accent);
    font-family: var(--font-hand);
    letter-spacing: 0.2em;
  }
  .board-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--ornament), transparent);
    opacity: 0.55;
    order: 2;
  }
  .board-title em {
    order: 3;
    font-style: normal;
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--muted);
    white-space: nowrap;
  }
  .board-sub {
    margin-top: 8px;
    font-size: 0.86rem;
    /* 这条是压在插画最亮的地方（墙面）上的，用 --muted 会糊掉，
       所以走正文字色 + 一点透明度，配下面的字影 */
    color: var(--text);
    opacity: 0.72;
  }
  /* 页首这块文字是直接压在插画带上的，给一层同底色柔光字影才读得清
     （text-shadow 会继承，所以 em 之类的子元素也一起有） */
  .board-title,
  .board-sub,
  .year {
    text-shadow: 0 1px 12px var(--bg), 0 1px 2px var(--bg);
  }
  .year-group {
    margin-top: 30px;
  }
  .year {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.02rem;
    color: var(--accent);
    font-family: var(--font-hand);
    letter-spacing: 0.2em;
  }
  .year::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--ornament), transparent);
    opacity: 0.55;
  }
  .year em {
    font-style: normal;
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--muted);
    order: 3;
  }
  .year span {
    order: 1;
  }
  .year svg {
    order: 0;
  }
  .year::after {
    order: 2;
  }
  .grid {
    margin-top: 16px;
    display: grid;
    /* min(100%, …) 是护栏：窄屏（<340px）时列宽退回容器宽，不然会横向溢出 */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }
  /* 项目通常只有几篇，卡片大一点更像作品墙 */
  .board--projects .grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr));
  }
  /* 语录是长条卡：宽屏两列并排，一句一条 */
  .qgrid {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 460px), 1fr));
    gap: 16px;
  }
</style>
