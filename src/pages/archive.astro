---
import BaseLayout from '../layouts/BaseLayout.astro';
import StarMap from '../components/StarMap.astro';
import Playbill from '../components/Playbill.astro';
import { getCollection } from 'astro:content';
import { POST_QUOTES } from '../consts';

const B = import.meta.env.BASE_URL.replace(/\/+$/, '');
const posts = (await getCollection('posts', ({ data }) => (import.meta.env.PROD ? !data.draft : true))).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
);
const stars = posts.map((p) => ({
  id: p.id,
  title: p.data.title,
  year: p.data.date.getFullYear(),
  dateISO: `${p.data.date.getFullYear()}-${String(p.data.date.getMonth() + 1).padStart(2, '0')}-${String(p.data.date.getDate()).padStart(2, '0')}`,
  url: `${B}/posts/${p.id}`,
}));

/* 语录星：title = 全文（悬停浮出），点它跳文章栏目的语录分类 */
const quotes = POST_QUOTES.map((q) => ({
  title: q.text,
  dateISO: q.date,
  url: `${B}/posts/#quotes`,
}));

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
---

<BaseLayout title="星空猫座" description="全部文章的星图归档——每篇文章都是一颗星。">
  {/* 整页背景（固定铺满）：荒 = 夜城，芒 = 午后阳台。两张图按主题各挂一套，令牌见 tokens.css */}
  <div class="page-bg" aria-hidden="true"></div>

  <section class="container">
    <Playbill
      kicker="THE CONSTELLATION"
      title="星空猫座"
      sub={`每篇文章都是一颗星，按年份连成星座；语录是散在一旁的金色小星尘。共 ${posts.length} 颗星 · ${quotes.length} 句语录在你头顶闪烁。`}
      motif="star"
    />

    <StarMap stars={stars} quotes={quotes} />

    <!-- 列表视图降级（无 JS / 低性能设备 / SEO） -->
    <details class="list-view">
      <summary>切换为列表视图</summary>
      {
        [...byYear.entries()].map(([year, list]) => (
          <section>
            <h2>{year}</h2>
            <ul>
              {list.map((p) => (
                <li>
                  <a href={`${B}/posts/${p.id}`}>
                    <span class="d">{String(p.data.date.getMonth() + 1).padStart(2, '0')}-{String(p.data.date.getDate()).padStart(2, '0')}</span>
                    {p.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      <section>
        <h2>语录</h2>
        <ul>
          {POST_QUOTES.map((q) => (
            <li>
              <a href={`${B}/posts/#quotes`}>
                <span class="d">{q.date.slice(5).replace('-', '-')}</span>
                {q.text}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </details>
  </section>
</BaseLayout>

<style>
  /* 整页背景：与关于页同一套写法（fixed 铺满 + ::after 压一层主题色）。
     图本身按主题换（荒=夜城 / 芒=午后阳台），透明度走 --archive-* 令牌。 */
  .page-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-image: var(--archive-bg);
    background-size: cover;
    background-position: var(--archive-bg-pos, 50% 30%);
    background-repeat: no-repeat;
    opacity: var(--archive-img-o, 0.6);
    pointer-events: none;
  }
  .page-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--bg);
    opacity: var(--archive-veil-o, 0.5);
  }

  .container {
    padding-block: 40px 20px;
  }
  /* 列表视图是裸文字，直接压在插画上 → 同底色柔光字影（与文章列表页同规则） */
  .list-view summary,
  .list-view h2,
  .list-view a,
  .list-view .d {
    text-shadow: 0 1px 12px var(--bg), 0 1px 2px var(--bg);
  }
  .list-view {
    margin-top: 24px;
    color: var(--text);
  }
  .list-view summary {
    cursor: pointer;
    color: var(--accent);
    font-size: 0.92rem;
    user-select: none;
  }
  .list-view section {
    margin-top: 20px;
  }
  .list-view h2 {
    font-family: var(--font-hand);
    color: var(--accent);
    font-size: 1.1rem;
  }
  .list-view ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 8px;
    margin-top: 10px;
  }
  .list-view a {
    color: var(--text);
    display: flex;
    gap: 12px;
  }
  .list-view a:hover {
    color: var(--accent);
  }
  .d {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--muted);
  }
</style>

<script>
  import { catnest } from '../scripts/catnest';
  catnest.unlock('stargazer');
</script>
