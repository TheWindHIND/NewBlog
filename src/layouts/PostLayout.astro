---
import BaseLayout from './BaseLayout.astro';
import CatTailProgress from '../components/CatTailProgress.astro';
import FeedButton from '../components/FeedButton.astro';
import CurtainOpen from '../components/CurtainOpen.astro';
import type { CollectionEntry } from 'astro:content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'posts'>;
  headings: Heading[];
  readingMinutes: number;
  seriesNav?: { prev?: { href: string; title: string }; next?: { href: string; title: string } };
  kbNav?: { prev?: string; next?: string };
}

const B = import.meta.env.BASE_URL.replace(/\/+$/, '');
const { post, headings, readingMinutes, seriesNav, kbNav } = Astro.props;
const d = post.data;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout title={d.title} description={d.description}>
  <CatTailProgress />
  <CurtainOpen
    title={d.title}
    act={d.series && d.seriesIndex ? `${d.series} · 第 ${d.seriesIndex} 幕` : '本场剧目'}
  />

  <article class="post container" data-post-slug={post.id}>
    {/* 键盘导航锚点（j/k） */}
    {kbNav?.prev && <a data-kb-prev href={kbNav.prev} hidden aria-hidden="true">prev</a>}
    {kbNav?.next && <a data-kb-next href={kbNav.next} hidden aria-hidden="true">next</a>}

    <header class="post-head">
      <a class="back" href={`${B}/posts`}>← 全部文章</a>
      <div class="meta">
        <time datetime={d.date.toISOString()}>
          {d.date.getFullYear()} 年 {d.date.getMonth() + 1} 月 {d.date.getDate()} 日
        </time>
        {d.updated && d.updated.valueOf() !== d.date.valueOf() && (
          <span class="dot">·</span>
          <span>更新于 {d.updated.getFullYear()}-{String(d.updated.getMonth() + 1).padStart(2, '0')}-{String(d.updated.getDate()).padStart(2, '0')}</span>
        )}
        <span class="dot">·</span>
        <span data-reading>约 {readingMinutes} 分钟</span>
        {d.series && <span class="series">{d.series}{d.seriesIndex ? ` · 第 ${d.seriesIndex} 篇` : ''}</span>}
      </div>
      <h1>{d.title}</h1>
      <div class="tags">
        {d.tags.map((t) => <a class="tag" href={`${B}/tags/${t}`}>#{t}</a>)}
      </div>
    </header>

    <div class:list={['post-body-wrap', { 'with-toc': toc.length > 1 }]}>
      {
        toc.length > 1 && (
          <aside class="toc" aria-label="目录">
            <p class="toc-title">目录</p>
            <ul>
              {toc.map((h) => (
                <li class:list={[`lv${h.depth}`]}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
      <div class="prose">
        <slot />
      </div>
    </div>

    {
      seriesNav && (seriesNav.prev || seriesNav.next) && (
        <nav class="series-nav" aria-label="系列文章导航">
          {seriesNav.prev ? (
            <a class="sn" href={seriesNav.prev.href}>
              <span>← 上一篇</span>
              <strong>{seriesNav.prev.title}</strong>
            </a>
          ) : (
            <span />
          )}
          {seriesNav.next ? (
            <a class="sn right" href={seriesNav.next.href}>
              <span>下一篇 →</span>
              <strong>{seriesNav.next.title}</strong>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }

    <div class="feed-area">
      <FeedButton slug={post.id} />
      <p class="feed-tip">按 <kbd>J</kbd> / <kbd>K</kbd> 在文章间跳跃 · <kbd>R</kbd> 随机一页</p>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: 40px 20px;
    max-width: 880px;
  }
  .back {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .meta {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .dot {
    opacity: 0.5;
  }
  .series {
    color: var(--accent-2);
    background: var(--accent-2-soft);
    padding: 1px 10px;
    border-radius: 999px;
  }
  h1 {
    margin-top: 10px;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
  }
  .tags {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag {
    font-size: 0.8rem;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 2px 11px;
    border-radius: 999px;
  }

  .post-body-wrap {
    margin-top: 34px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 34px;
  }
  @media (min-width: 1080px) {
    .post-body-wrap.with-toc {
      grid-template-columns: 200px minmax(0, 1fr);
    }
    .post {
      max-width: 1080px;
    }
  }
  .toc {
    display: none;
  }
  @media (min-width: 1080px) {
    .toc {
      display: block;
      position: sticky;
      top: calc(var(--nav-h) + 24px);
      align-self: start;
      font-size: 0.86rem;
      border-left: 2px solid var(--border);
      padding-left: 14px;
    }
  }
  .toc-title {
    font-weight: 700;
    color: var(--text-strong);
    margin-bottom: 8px;
  }
  .toc ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .toc a {
    color: var(--muted);
  }
  .toc a:hover {
    color: var(--accent);
  }
  .toc .lv3 {
    padding-left: 14px;
  }

  /* 系列导航 */
  .series-nav {
    margin-top: 48px;
    display: flex;
    justify-content: space-between;
    gap: 14px;
  }
  /* 投喂区 */
  .feed-area {
    margin-top: 30px;
    padding: 22px;
    text-align: center;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--accent-soft);
  }
  .feed-tip {
    margin-top: 12px;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .feed-tip kbd {
    font-family: var(--font-mono);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 1px 6px;
    font-size: 0.74rem;
  }
  .sn {
    flex: 1;
    max-width: 46%;
    display: grid;
    gap: 3px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    color: var(--text);
    transition: border-color 0.25s, transform 0.25s var(--ease-water);
  }
  .sn:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
    color: var(--text);
  }
  .sn.right {
    justify-items: end;
    text-align: right;
  }
  .sn span {
    font-size: 0.76rem;
    color: var(--muted);
  }
  .sn strong {
    font-size: 0.92rem;
    color: var(--accent);
  }
</style>

<style>
  /* ---------- 正文排版（prose） ---------- */
  .prose {
    font-size: 1.02rem;
    min-width: 0;
  }
  .prose h2 {
    margin-top: 2.2em;
    padding-bottom: 6px;
    border-bottom: 1px dashed var(--border-strong);
  }
  .prose h3 {
    margin-top: 1.8em;
  }
  .prose p {
    margin-block: 1em;
  }
  .prose img {
    border-radius: var(--radius);
    margin-inline: auto;
    box-shadow: var(--shadow);
  }
  .prose blockquote {
    margin-block: 1.2em;
    padding: 10px 18px;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--text);
  }
  .prose blockquote p {
    margin-block: 0.3em;
  }
  .prose code:not(pre code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--accent-soft);
    color: var(--accent-2);
    padding: 2px 7px;
    border-radius: 6px;
  }
  .prose pre {
    padding: 18px 20px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    overflow-x: auto;
    font-size: 0.88rem;
  }
  .prose pre code {
    font-family: var(--font-mono);
  }
  /* Shiki 双主题：荒主题用 dark 配色 */
  :root[data-theme='ousia'] .prose .astro-code,
  :root[data-theme='ousia'] .prose .astro-code span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
  }
  .prose ul,
  .prose ol {
    padding-left: 1.4em;
    margin-block: 0.8em;
  }
  .prose li {
    margin-block: 0.3em;
  }
  .prose hr {
    border: none;
    border-top: 1px dashed var(--border-strong);
    margin-block: 2em;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin-block: 1.2em;
    font-size: 0.92rem;
  }
  .prose th,
  .prose td {
    border: 1px solid var(--border);
    padding: 8px 12px;
  }
  .prose th {
    background: var(--accent-soft);
  }
</style>

<script>
  import { catnest } from '../scripts/catnest';

  // 阅读成就：滚到底部并停留 10 秒，计入「读完」
  const article = document.querySelector('[data-post-slug]');
  const slug = article?.getAttribute('data-post-slug');
  if (slug) {
    let timer: ReturnType<typeof setTimeout> | undefined;
    const onScroll = () => {
      const doc = document.documentElement;
      const atBottom = innerHeight + scrollY >= doc.scrollHeight - 80;
      if (atBottom && timer === undefined) {
        timer = setTimeout(() => {
          catnest.markRead(slug);
          timer = undefined;
        }, 10000);
      } else if (!atBottom && timer !== undefined) {
        clearTimeout(timer);
        timer = undefined;
      }
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
